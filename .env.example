# Strava OAuth credentials.
# Strava OAuth credentials.
# Register an app at https://www.strava.com/settings/api and copy the values here.
# The Authorization Callback Domain must match the host of STRAVA_REDIRECT_URI
# (for local dev set it to "localhost").
STRAVA_CLIENT_ID=your-client-id
STRAVA_CLIENT_SECRET=your-client-secret

# Defaults to http://localhost:3000/api/strava/auth/callback if not set.
# STRAVA_REDIRECT_URI=https://your-domain.com/api/strava/auth/callback
